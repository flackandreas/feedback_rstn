# Hochgeladene Dateien gehoeren nicht ins Repository. Sie entstehen im
# Betrieb - Atteste zu Krankmeldungen, Hausaufgabenbilder, Jahresarchive -
# und koennen personenbezogen sein; das Repository ist oeffentlich.
# Die .htaccess darin bleibt getrackt, sie schaltet dort die PHP-Ausfuehrung ab.
src/public/uploads/*
!src/public/uploads/.htaccess

# Ablage: Zwischenspeicher der Portal-Anbindung (Entdeckungsdokument, JWKS).
# Entsteht im Betrieb und ist je Installation verschieden.
src/storage/

# Development Database
db-data/

# Environment and Secrets (if any added later)
.env
.env.*
*.secret
# Das ganze Verzeichnis, nicht nur die JSON-Dateien: hier lag eine
# Word-Datei mit der Client-ID und dem Clientschluessel eines
# Google-OAuth-Clients, und die Regel "Oauth/*.json" hat sie durchgelassen.
Oauth/


# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo

# Temporary Files
/tmp
/tmp/
*.tmp
*.bak

# Zwischenspeicher von tFPDF: beim ersten Ausdruck nach Vordruck LBV 1211
# legt es die Schriftmetriken neben die TTF-Dateien. Entsteht im Betrieb.
src/vendor/setasign/tfpdf/font/unifont/*.mtx.php
src/vendor/setasign/tfpdf/font/unifont/*.cw.dat
src/vendor/setasign/tfpdf/font/unifont/*.cw127.php
