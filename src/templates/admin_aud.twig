{% extends "base.twig" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Verwaltung: Außerunterrichtliche Veranstaltungen (AUD)</h2>
    <a href="/admin_dashboard.php" class="btn" style="border: 1px solid var(--border-color); color: var(--text-dark); padding: 8px 16px; border-radius: 6px; text-decoration: none;">&larr; Zurück</a>
</div>

{# =====================================================================
   SLIDE-IN DETAIL PANEL
   ===================================================================== #}
<div id="detail-overlay" onclick="closeDetailPanel()" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:1000;"></div>
<div id="detail-panel" style="display:none; position:fixed; top:0; right:0; width:min(480px,95vw); height:100vh; background:var(--card-bg, #fff); box-shadow:-4px 0 24px rgba(0,0,0,0.18); z-index:1001; overflow-y:auto; padding:30px 28px; transition: transform 0.3s ease; transform: translateX(100%);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 id="panel-title" style="margin:0;">Antrag Details</h3>
        <button onclick="closeDetailPanel()" style="background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--text-muted);">&times;</button>
    </div>
    <div id="panel-body"></div>
    <div id="panel-actions" style="margin-top:24px; border-top:1px solid var(--border-color); padding-top:16px;"></div>
</div>

<div class="content-box">
    <h3 style="border-left: 4px solid var(--primary-color); padding-left: 10px;">AUD-Tage Übersicht</h3>
    <p style="color: var(--text-muted); margin-bottom: 15px;">Übersicht der angemeldeten außerunterrichtlichen Veranstaltungen und freien Lehrkräfte für jeden AUD-Tag.</p>
    
    <div class="aud-accordions">
        {% for aud_name, free_teachers in aud_free %}
            {# Find requests for this AUD #}
            {% set aud_requests = [] %}
            {% for r in extra_requests %}
                {% if r.aud_type == aud_name %}
                    {% set aud_requests = aud_requests|merge([r]) %}
                {% endif %}
            {% endfor %}
            
            <div style="margin-bottom: 10px; background: white; border: 1px solid #ddd; border-radius: 6px; overflow: hidden;">
                <button type="button" style="width: 100%; text-align: left; padding: 12px 15px; background: #f8f9fa; color: #333; border: none; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center;" onclick="const p = this.nextElementSibling; const isHidden = p.style.display === 'none'; p.style.display = isHidden ? 'block' : 'none'; this.children[1].textContent = isHidden ? '▲' : '▼';">
                    <span>
                        {{ aud_name }} 
                        <span style="font-weight: normal; font-size: 0.85em; color: var(--text-muted); margin-left: 10px;">
                            ({{ aud_requests|length }} Veranstaltung(en), {{ free_teachers|length }} freie Lehrkräfte)
                        </span>
                    </span>
                    <span>▼</span>
                </button>
                <div style="display: none; padding: 15px; border-top: 1px solid #ddd;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                        
                        <!-- Section: Extracurricular Events -->
                        <div>
                            <h4 style="margin-top: 0; margin-bottom: 12px; border-bottom: 1px solid #eee; padding-bottom: 5px; color: var(--primary-color);">
                                🚌 Angemeldete Veranstaltungen
                            </h4>
                            {% if aud_requests is empty %}
                                <p style="color: var(--text-muted); font-size: 0.9em; margin: 5px 0;">Keine Veranstaltungen für diesen AUD angemeldet.</p>
                            {% else %}
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                {% for r in aud_requests %}
                                    {% set data = {
                                        type: 'ausflug',
                                        id: r.id,
                                        teacher: r.teacher_name ~ ' (' ~ r.kuerzel ~ ')',
                                        event_date: r.event_date|date('d.m.Y'),
                                        event_date_to: r.event_date_to ? r.event_date_to|date('d.m.Y') : '',
                                        class_name: r.class_name|default(''),
                                        destination: r.destination|default(''),
                                        role: r.role|default(''),
                                        companion: r.companion|default(''),
                                        event_name: r.event_name|default(''),
                                        costs: r.costs|default(''),
                                        transport: r.transport|default(''),
                                        start_time: r.start_time|default(''),
                                        start_location: r.start_location|default(''),
                                        return_time: r.return_time|default(''),
                                        return_location: r.return_location|default(''),
                                        return_trip_arranged: r.return_trip_arranged,
                                        supervisors: r.supervisors|default(''),
                                        consent_form: r.consent_form|default(''),
                                        schedule_notified: r.schedule_notified,
                                        status: r.status
                                    } %}
                                    <div class="detail-row" 
                                         data-info="{{ data|json_encode|e('html_attr') }}"
                                         style="padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 6px; background-color: #f8fafc; font-size: 0.9em; cursor: pointer; transition: background-color 0.2s;"
                                         onmouseover="this.style.backgroundColor='#edf2f7'"
                                         onmouseout="this.style.backgroundColor='#f8fafc'"
                                         title="Klicken für Details">
                                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 3px;">
                                            <strong style="color: var(--text-dark);">{{ r.event_name }}</strong>
                                            <span class="badge" style="font-size: 0.75em; padding: 2px 6px; border-radius: 4px; background: {% if r.status == 'approved' %}var(--success-color){% elseif r.status == 'pending' %}var(--warning-color-dark){% else %}var(--danger-color){% endif %}; color: white; font-weight: 600;">
                                                {{ r.status }}
                                            </span>
                                        </div>
                                        <div style="color: var(--text-muted); font-size: 0.85em; line-height: 1.4;">
                                            <strong>Klassen:</strong> {{ r.class_name }} | <strong>Ziel:</strong> {{ r.destination }} <br>
                                            <strong>Leitung:</strong> {{ r.teacher_name }} ({{ r.kuerzel }})
                                        </div>
                                    </div>
                                {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                        
                        <!-- Section: Free Teachers -->
                        <div>
                            <h4 style="margin-top: 0; margin-bottom: 12px; border-bottom: 1px solid #eee; padding-bottom: 5px; color: var(--success-color);">
                                👥 Freie Lehrkräfte
                            </h4>
                            {% if free_teachers is empty %}
                                <p style="color: var(--text-muted); font-size: 0.9em; margin: 5px 0;">Alle Lehrkräfte sind eingeteilt.</p>
                            {% else %}
                                <ul style="margin: 0 0 12px 0; padding-left: 20px; font-size: 0.9em; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 5px;">
                                {% for teacher in free_teachers %}
                                    <li>{{ teacher.name }} ({{ teacher.kuerzel }})</li>
                                {% endfor %}
                                </ul>
                                
                                <textarea id="copy-aud-{{ loop.index }}" style="display:none;">
=== Freie Lehrkräfte - {{ aud_name }} ===
{% for teacher in free_teachers %}
- {{ teacher.name }} ({{ teacher.kuerzel }})
{% endfor %}
                                </textarea>
                                <button type="button" class="button-secondary" style="font-size: 0.8em; padding: 6px 12px;" onclick="copyAudContent('copy-aud-{{ loop.index }}')">📋 Freie kopieren</button>
                            {% endif %}
                        </div>
                        
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<div class="content-box">
    <h3 style="border-left: 4px solid var(--primary-color); padding-left: 10px;">Anträge auf außerunterrichtliche Veranstaltungen</h3>
    
    {% if extra_requests is empty %}
        <p style="color: var(--text-muted);">Keine Anträge vorhanden.</p>
    {% else %}
        <div style="overflow-x: auto;">
            <table class="data-table simple" style="font-size: 0.9em;">
                <thead>
                    <tr>
                        <th>AUD</th>
                        <th>Lehrkraft</th>
                        <th>Datum</th>
                        <th>Klasse(n)</th>
                        <th>Ziel</th>
                        <th>Aktion</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in extra_requests %}
                        {% set data = {
                            type: 'ausflug',
                            id: r.id,
                            teacher: r.teacher_name ~ ' (' ~ r.kuerzel ~ ')',
                            event_date: r.event_date|date('d.m.Y'),
                            event_date_to: r.event_date_to ? r.event_date_to|date('d.m.Y') : '',
                            class_name: r.class_name|default(''),
                            destination: r.destination|default(''),
                            role: r.role|default(''),
                            companion: r.companion|default(''),
                            event_name: r.event_name|default(''),
                            costs: r.costs|default(''),
                            transport: r.transport|default(''),
                            start_time: r.start_time|default(''),
                            start_location: r.start_location|default(''),
                            return_time: r.return_time|default(''),
                            return_location: r.return_location|default(''),
                            return_trip_arranged: r.return_trip_arranged,
                            supervisors: r.supervisors|default(''),
                            consent_form: r.consent_form|default(''),
                            schedule_notified: r.schedule_notified,
                            status: r.status
                        } %}
                        <tr style="{{ (r.status != 'pending' and r.status != 'query') ? 'opacity: 0.65;' : '' }} cursor:pointer;"
                            class="detail-row"
                            data-info="{{ data|json_encode|e('html_attr') }}"
                            title="Klicken für Details">
                            <td><strong style="color: var(--primary-color);">{{ r.aud_type|default('-') }}</strong></td>
                            <td style="font-weight: 600;">
                                {{ r.teacher_name }} <span style="font-size: 0.8em; color: var(--text-muted);">({{ r.kuerzel }})</span>
                            </td>
                            <td>
                                {% if r.event_date_to and r.event_date_to != r.event_date %}
                                    {{ r.event_date|date('d.m.Y') }} - {{ r.event_date_to|date('d.m.Y') }}
                                {% else %}
                                    {{ r.event_date|date('d.m.Y') }}
                                {% endif %}
                            </td>
                            <td>{{ r.class_name }}</td>
                            <td>{{ r.destination }}</td>
                            <td onclick="event.stopPropagation();">
                                {% if r.status == 'pending' %}
                                    <form method="POST" action="/admin_action.php" style="display:inline-block; margin:0;" class="admin-action-form">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <input type="hidden" name="id" value="{{ r.id }}">
                                        <input type="hidden" name="type" value="ausflug">
                                        <button type="button" class="button-primary btn-approve" style="background-color: var(--success-color); padding: 5px 10px; font-size: 0.85em; margin-right: 5px;" title="Genehmigen">✓</button>
                                        <button type="button" class="button-warning btn-query" style="background-color: var(--warning-color); padding: 5px 10px; font-size: 0.85em; margin-right: 5px; color: white; border: none;" title="Rückfrage">❓</button>
                                        <button type="button" class="button-danger btn-reject" style="padding: 5px 10px; font-size: 0.85em;" title="Ablehnen">✗</button>
                                        <input type="hidden" name="action" value="" class="action-input">
                                    </form>
                                {% elseif r.status == 'query' %}
                                    <form method="POST" action="/admin_action.php" style="display:inline-block; margin:0;" class="admin-action-form">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <input type="hidden" name="id" value="{{ r.id }}">
                                        <input type="hidden" name="type" value="ausflug">
                                        <button type="button" class="button-primary btn-approve" style="background-color: var(--success-color); padding: 5px 10px; font-size: 0.85em; margin-right: 5px;" title="Genehmigen">✓</button>
                                        <button type="button" class="button-danger btn-reject" style="padding: 5px 10px; font-size: 0.85em;" title="Ablehnen">✗</button>
                                        <input type="hidden" name="action" value="" class="action-input">
                                    </form>
                                    <div style="margin-top: 5px;"><span class="badge" style="background-color: var(--warning-color); color: white; font-size: 0.75em;">RÜCKFRAGE</span></div>
                                {% else %}
                                    {% set statusColor = (r.status == 'approved') ? 'var(--success-color)' : 'var(--danger-color)' %}
                                    {% set statusText = (r.status == 'approved') ? 'GENEHMIGT' : 'ABGELEHNT' %}
                                    <span style="color: {{ statusColor }}; font-weight: 600; font-size: 0.85em;">{{ statusText }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{% endblock %}

{% block extra_scripts %}
<script>
document.addEventListener("DOMContentLoaded", function() {
    window.copyAudContent = function(elementId) {
        var el = document.getElementById(elementId);
        if (!el) return;
        var displayWas = el.style.display;
        if(displayWas === 'none') { el.style.display = 'block'; }
        el.select();
        el.setSelectionRange(0, 99999);
        try {
            document.execCommand('copy');
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'In die Zwischenablage kopiert!',
                showConfirmButton: false,
                timer: 2000
            });
        } catch (err) {}
        if(displayWas === 'none') { el.style.display = 'none'; }
    };
});

function row(label, value) {
    if (!value && value !== 0) return '';
    return `<div style="display:grid;grid-template-columns:140px 1fr;gap:6px;padding:8px 0;border-bottom:1px solid var(--border-color,#eee);">
        <span style="font-size:0.8em;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;">${label}</span>
        <span>${value}</span>
    </div>`;
}

function badge(ok) {
    return ok ? `<span style="color:var(--success-color);font-weight:600;">✓ Ja</span>` : `<span style="color:var(--text-muted);">– Nein</span>`;
}

function openDetailPanel(d) {
    let title = 'Außerunterrichtliche Veranstaltung';
    let body = '';
    body += row('Lehrkraft', d.teacher);
    body += row('Als', d.role);
    body += row('Klasse(n)', d.class_name);
    body += row('Begleitperson', d.companion);
    let dateVal = d.event_date;
    if (d.event_date_to && d.event_date_to !== d.event_date) {
        dateVal = `${d.event_date} - ${d.event_date_to}`;
    }
    body += row('Datum', dateVal);
    body += row('Veranstaltung', d.event_name);
    body += row('Ziel / Strecke', d.destination);
    body += row('Kosten ca.', d.costs);
    body += row('Verkehrsmittel', d.transport);
    if (d.start_time) body += row('Beginn', `${d.start_time} Uhr, ${d.start_location||'—'}`);
    if (d.return_time) body += row('Rückkehr', `${d.return_time} Uhr, ${d.return_location||'—'}`);
    body += row('Heimfahrt geregelt', badge(d.return_trip_arranged));
    body += row('Aufsicht', d.supervisors);
    body += row('Einverständniserklärung', d.consent_form ? `<strong>${d.consent_form.toUpperCase()}</strong>` : '—');
    body += row('Stundenplan benachrichtigt', badge(d.schedule_notified));

    const statusColor = d.status === 'approved' ? 'var(--success-color)' : (d.status === 'rejected' ? 'var(--danger-color)' : (d.status === 'query' ? 'var(--warning-color)' : 'var(--text-muted)'));
    const statusText = d.status === 'approved' ? 'GENEHMIGT' : (d.status === 'rejected' ? 'ABGELEHNT' : (d.status === 'query' ? 'RÜCKFRAGE' : 'AUSSTEHEND'));
    body += row('Status', `<span style="color:${statusColor};font-weight:700;">${statusText}</span>`);

    document.getElementById('panel-title').textContent = title;
    document.getElementById('panel-body').innerHTML = body;
    document.getElementById('panel-actions').innerHTML = '';

    const panel = document.getElementById('detail-panel');
    const overlay = document.getElementById('detail-overlay');
    panel.style.display = 'block';
    overlay.style.display = 'block';
    requestAnimationFrame(() => { panel.style.transform = 'translateX(0)'; });
}

function closeDetailPanel() {
    const panel = document.getElementById('detail-panel');
    panel.style.transform = 'translateX(100%)';
    setTimeout(() => {
        panel.style.display = 'none';
        document.getElementById('detail-overlay').style.display = 'none';
    }, 300);
}

document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll('.detail-row').forEach(row => {
        row.addEventListener('click', function() {
            const d = JSON.parse(this.dataset.info);
            openDetailPanel(d);
        });
    });

    document.querySelectorAll('.btn-approve').forEach(button => {
        button.addEventListener('click', function(e) {
            const form = this.closest('form');
            form.querySelector('.action-input').value = 'approve';
            Swal.fire({
                title: 'Genehmigen?',
                text: "Soll dieser Antrag wirklich genehmigt werden?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: 'var(--success-color)',
                confirmButtonText: 'Ja, genehmigen',
                cancelButtonText: 'Abbrechen'
            }).then((result) => { if (result.isConfirmed) form.submit(); });
        });
    });

    document.querySelectorAll('.btn-reject').forEach(button => {
        button.addEventListener('click', function(e) {
            const form = this.closest('form');
            form.querySelector('.action-input').value = 'reject';
            Swal.fire({
                title: 'Ablehnen?',
                text: "Soll dieser Antrag wirklich abgelehnt werden?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: 'var(--danger-color)',
                confirmButtonText: 'Ja, ablehnen',
                cancelButtonText: 'Abbrechen'
            }).then((result) => { if (result.isConfirmed) form.submit(); });
        });
    });

    document.querySelectorAll('.btn-query').forEach(button => {
        button.addEventListener('click', function(e) {
            const form = this.closest('form');
            form.querySelector('.action-input').value = 'query';
            Swal.fire({
                title: 'Rücksprache halten?',
                text: "Soll die Lehrkraft zu einer Rücksprache aufgefordert werden?",
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: 'var(--warning-color)',
                confirmButtonText: 'Ja, Rückfrage stellen',
                cancelButtonText: 'Abbrechen'
            }).then((result) => { if (result.isConfirmed) form.submit(); });
        });
    });

    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDetailPanel(); });
});
</script>
{% endblock %}
