{% extends "base.twig" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Zentrale Verwaltung (Schulleitung)</h2>
</div>



{# =====================================================================
   SLIDE-IN DETAIL PANEL (shared for all request types)
   ===================================================================== #}
<div id="detail-overlay" onclick="closeDetailPanel()" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:1000;"></div>
<div id="detail-panel" style="display:none; position:fixed; top:0; right:0; width:min(480px,95vw); height:100vh; background:var(--card-bg, #fff); box-shadow:-4px 0 24px rgba(0,0,0,0.18); z-index:1001; overflow-y:auto; padding:30px 28px; transition: transform 0.3s ease; transform: translateX(100%);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 id="panel-title" style="margin:0;">Antrag Details</h3>
        <button onclick="closeDetailPanel()" style="background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--text-muted);">&times;</button>
    </div>
    <div id="panel-body"></div>
    <div id="panel-actions" style="margin-top:24px; border-top:1px solid var(--border-color); padding-top:16px;"></div>
</div>

{# =====================================================================
   SECTION 1: Krankmeldungen
   ===================================================================== #}
<div class="content-box">
    <h3 style="border-left: 4px solid var(--danger-color); padding-left: 10px;">Aktuelle & Zukünftige Krankmeldungen</h3>
    {% if sick_leaves_current is empty %}
        <p style="color: var(--text-muted);">Keine aktuellen Krankmeldungen vorhanden.</p>
    {% else %}
        <div style="overflow-x: auto;">
            <table class="data-table simple">
                <thead>
                    <tr>
                        <th>Eingang</th>
                        <th>Lehrkraft</th>
                        <th>Von</th>
                        <th>Bis</th>
                        <th>Notizen</th>
                        <th>Vertretungsmaterial</th>
                        <th>Anlage</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in sick_leaves_current %}
                        <tr>
                            <td style="font-size: 0.85em; color: var(--text-muted);">{{ r.created_at|date('d.m.y H:i') }}</td>
                            <td style="font-weight: 600;">{{ r.teacher_name }} <span style="font-size: 0.8em; color: var(--text-muted);">({{ r.kuerzel }})</span></td>
                            <td>{{ r.date_main|date('d.m.Y') }}</td>
                            <td>{{ r.date_to|date('d.m.Y') }}</td>
                            <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="{{ r.details }}">{{ r.details|default('-') }}</td>
                            <td>
                                {% if r.material_link %}
                                    <a href="{{ r.material_link }}" target="_blank" class="button-secondary" style="padding: 2px 8px; font-size: 0.8em; color: var(--primary-color);">🚀 Material</a>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>
                                {% if r.attachment_path %}
                                    <a href="/{{ r.attachment_path }}" target="_blank" class="button-secondary" style="padding: 2px 8px; font-size: 0.8em;">Ansehen</a>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<!-- Section 1.5: Historie Krankmeldungen -->
<div class="content-box">
    <h3 style="border-left: 4px solid #6c757d; padding-left: 10px;">Historie Krankmeldungen</h3>
    
    <div style="margin-bottom: 20px;">
        <label for="history_teacher_select" style="font-weight: 600;">Lehrkraft auswählen:</label>
        <select id="history_teacher_select" style="padding: 10px; width: 300px; border: 1px solid #ccc; border-radius: 4px; margin-left: 10px;">
            <option value="">-- Bitte wählen --</option>
            {% for teacher in sick_history_by_teacher %}
                <option value="tid_{{ teacher.id }}">{{ teacher.name }} ({{ teacher.kuerzel }})</option>
            {% endfor %}
        </select>
    </div>

    {% for teacher in sick_history_by_teacher %}
    <div class="history-teacher-block" id="tid_{{ teacher.id }}" style="display: none; padding: 15px; border: 1px solid #eee; background: #fcfcfc; border-radius: 6px; margin-bottom: 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h4 style="margin: 0; font-size: 1.1em;">{{ teacher.name }} ({{ teacher.kuerzel }})</h4>
            <div style="text-align: right;">
                <span style="font-weight: 600; color: var(--danger-color); display: block; font-size: 1.1em;">Bisherige Krankheitstage: {{ teacher.total_days }}</span>
                <a href="/export_sick_leaves.php?teacher_id={{ teacher.id }}" target="_blank" class="button-secondary" style="font-size: 0.8em; margin-top: 5px; display: inline-block;">📄 Als PDF Exportieren</a>
            </div>
        </div>
        
        <table class="data-table simple" style="font-size: 0.9em;">
            <thead>
                <tr>
                    <th>Gültig Von</th>
                    <th>Bis</th>
                    <th>Notizen</th>
                    <th>Anlage</th>
                </tr>
            </thead>
            <tbody>
                {% for r in teacher.records %}
                    <tr>
                        <td>{{ r.date_main|date('d.m.Y') }}</td>
                        <td>{{ r.date_to|date('d.m.Y') }}</td>
                        <td>{{ r.details|default('-') }}</td>
                        <td>
                            {% if r.attachment_path %}
                                <a href="/{{ r.attachment_path }}" target="_blank">Ansehen</a>
                            {% else %}-{% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endfor %}
</div>

{# =====================================================================
   SECTION 2: Freistellungen
   ===================================================================== #}
<div class="content-box">
    <h3 style="border-left: 4px solid var(--warning-color); padding-left: 10px;">Anträge auf Freistellung</h3>
    {% if exempt_requests is empty %}
        <p style="color: var(--text-muted);">Keine Anträge auf Freistellung vorhanden.</p>
    {% else %}
        <div style="overflow-x: auto;">
            <table class="data-table simple">
                <thead>
                    <tr>
                        <th>Eingang</th>
                        <th>Lehrkraft</th>
                        <th>Von</th>
                        <th>Bis</th>
                        <th>Art</th>
                        <th>Aktion</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in exempt_requests %}
                        {% set data = {
                            type: 'freistellung',
                            id: r.id,
                            teacher: r.teacher_name ~ ' (' ~ r.kuerzel ~ ')',
                            date_from: r.date_from|date('d.m.Y'),
                            date_to: r.date_to|date('d.m.Y'),
                            reason_type: r.reason_type|default(''),
                            days_of_week: r.days_of_week|default(''),
                            classes: r.classes|default(''),
                            hourly: r.hourly_exemption,
                            hour_from: r.hour_from|default(''),
                            hour_to: r.hour_to|default(''),
                            reason: r.reason|default(''),
                            status: r.status
                        } %}
                        <tr style="{{ (r.status != 'pending' and r.status != 'query') ? 'opacity: 0.65;' : '' }} cursor:pointer;" 
                            class="detail-row" 
                            data-info="{{ data|json_encode|e('html_attr') }}"
                            title="Klicken für Details">
                            <td style="font-size: 0.85em; color: var(--text-muted);">{{ r.created_at|date('d.m.y H:i') }}</td>
                            <td style="font-weight: 600;">{{ r.teacher_name }} <span style="font-size: 0.8em; color: var(--text-muted);">({{ r.kuerzel }})</span></td>
                            <td>{{ r.date_from|date('d.m.Y') }}</td>
                            <td>{{ r.date_to|date('d.m.Y') }}</td>
                            <td>{{ r.reason_type|default('—') }}</td>
                            <td onclick="event.stopPropagation();">
                                {% if r.status == 'pending' %}
                                    <form method="POST" action="/admin_action.php" style="display:inline-block; margin:0;" class="admin-action-form">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <input type="hidden" name="id" value="{{ r.id }}">
                                        <input type="hidden" name="type" value="freistellung">
                                        <button type="button" class="button-primary btn-approve" style="background-color: var(--success-color); padding: 5px 10px; font-size: 0.85em; margin-right: 5px;" title="Genehmigen">✓</button>
                                        <button type="button" class="button-warning btn-query" style="background-color: var(--warning-color); padding: 5px 10px; font-size: 0.85em; margin-right: 5px; color: white; border: none;" title="Rückfrage">❓</button>
                                        <button type="button" class="button-danger btn-reject" style="padding: 5px 10px; font-size: 0.85em;" title="Ablehnen">✗</button>
                                        <input type="hidden" name="action" value="" class="action-input">
                                    </form>
                                {% elseif r.status == 'query' %}
                                    <form method="POST" action="/admin_action.php" style="display:inline-block; margin:0;" class="admin-action-form">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <input type="hidden" name="id" value="{{ r.id }}">
                                        <input type="hidden" name="type" value="freistellung">
                                        <button type="button" class="button-primary btn-approve" style="background-color: var(--success-color); padding: 5px 10px; font-size: 0.85em; margin-right: 5px;" title="Genehmigen">✓</button>
                                        <button type="button" class="button-danger btn-reject" style="padding: 5px 10px; font-size: 0.85em;" title="Ablehnen">✗</button>
                                        <input type="hidden" name="action" value="" class="action-input">
                                    </form>
                                    <div style="margin-top: 5px;"><span class="badge" style="background-color: var(--warning-color); color: white; font-size: 0.75em;">RÜCKFRAGE</span></div>
                                {% else %}
                                    {% set statusColor = (r.status == 'approved') ? 'var(--success-color)' : 'var(--danger-color)' %}
                                    {% set statusText = (r.status == 'approved') ? 'GENEHMIGT' : 'ABGELEHNT' %}
                                    <span style="color: {{ statusColor }}; font-weight: 600; font-size: 0.85em;">{{ statusText }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# =====================================================================
   SECTION 3: Außerunterrichtliche Veranstaltungen
   ===================================================================== #}
<div class="content-box">
    <h3 style="border-left: 4px solid var(--primary-color); padding-left: 10px;">Außerunterrichtliche Veranstaltungen</h3>
    
    <div style="margin-bottom: 20px; padding: 15px; background: #eef2fb; border-radius: 6px;">
        <h4 style="margin-top: 0; margin-bottom: 15px;">Übersicht der freien Lehrkräfte (ohne Teilnahme)</h4>
        
        <div class="aud-accordions">
            {% for aud_name, free_teachers in aud_free %}
                <div style="margin-bottom: 10px; background: white; border: 1px solid #ddd; border-radius: 6px; overflow: hidden;">
                    <button type="button" style="width: 100%; text-align: left; padding: 12px 15px; background: #f8f9fa; color: #333; border: none; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center;" onclick="const p = this.nextElementSibling; const isHidden = p.style.display === 'none'; p.style.display = isHidden ? 'block' : 'none'; this.children[1].textContent = isHidden ? '▲' : '▼';">
                        <span>{{ aud_name }}</span>
                        <span>▼</span>
                    </button>
                    <div style="display: none; padding: 15px; border-top: 1px solid #ddd;">
                        {% if free_teachers is empty %}
                            <p style="color: var(--text-muted); margin: 0 0 10px 0;">Alle Lehrkräfte sind eingeteilt.</p>
                        {% else %}
                            <ul style="margin: 0 0 15px 0; padding-left: 20px;">
                            {% for teacher in free_teachers %}
                                <li>{{ teacher.name }} ({{ teacher.kuerzel }})</li>
                            {% endfor %}
                            </ul>
                            
                            <textarea id="copy-aud-{{ loop.index }}" style="display:none;">
=== Freie Lehrkräfte - {{ aud_name }} ===
{% for teacher in free_teachers %}
- {{ teacher.name }} ({{ teacher.kuerzel }})
{% endfor %}
                            </textarea>
                            <button type="button" class="button-secondary" style="font-size: 0.85em;" onclick="copyAudContent('copy-aud-{{ loop.index }}')">📋 In Zwischenablage kopieren</button>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Email Reporting Settings -->
    <div style="margin-bottom: 25px; padding: 15px; background: #fff; border: 1px solid #ddd; border-radius: 6px;">
        <h4 style="margin-top: 0; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 5px;">Automatische Weiterleitung konfigurieren</h4>
        <form method="POST" action="/admin_dashboard.php">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="save_settings" value="1">
            <div class="form-grid-3">
                <div class="form-group">
                    <label>E-Mail Adresse:</label>
                    <input type="email" name="report_email" placeholder="vertetung@schule.de" value="{{ app_settings['report_email'] }}">
                </div>
                <div class="form-group">
                    <label>Uhrzeit:</label>
                    <input type="time" name="report_time" value="{{ app_settings['report_time'] }}">
                </div>
                <div class="form-group">
                    <label>Intervall:</label>
                    <select name="report_interval">
                        <option value="daily" {{ app_settings['report_interval'] == 'daily' ? 'selected' : '' }}>Täglich</option>
                        <option value="weekly" {{ app_settings['report_interval'] == 'weekly' ? 'selected' : '' }}>Wöchentlich</option>
                        <option value="monthly" {{ app_settings['report_interval'] == 'monthly' ? 'selected' : '' }}>Monatlich</option>
                    </select>
                </div>
            </div>
            <div style="margin-top: 10px; text-align: right;">
                <button type="submit" class="button-primary">Speichern</button>
            </div>
        </form>
    </div>

    {% if extra_requests is empty %}
        <p style="color: var(--text-muted);">Keine Anträge auf außerunterrichtliche Veranstaltungen vorhanden.</p>
    {% else %}
        <div style="overflow-x: auto;">
            <table class="data-table simple" style="font-size: 0.9em;">
                <thead>
                    <tr>
                        <th>AUD</th>
                        <th>Datum</th>
                        <th>Klasse(n)</th>
                        <th>Ziel</th>
                        <th>Aktion</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in extra_requests %}
                        {% set data = {
                            type: 'ausflug',
                            id: r.id,
                            teacher: r.teacher_name ~ ' (' ~ r.kuerzel ~ ')',
                            event_date: r.event_date|date('d.m.Y'),
                            class_name: r.class_name|default(''),
                            destination: r.destination|default(''),
                            role: r.role|default(''),
                            companion: r.companion|default(''),
                            event_name: r.event_name|default(''),
                            costs: r.costs|default(''),
                            transport: r.transport|default(''),
                            start_time: r.start_time|default(''),
                            start_location: r.start_location|default(''),
                            return_time: r.return_time|default(''),
                            return_location: r.return_location|default(''),
                            return_trip_arranged: r.return_trip_arranged,
                            supervisors: r.supervisors|default(''),
                            consent_form: r.consent_form|default(''),
                            schedule_notified: r.schedule_notified,
                            status: r.status
                        } %}
                        <tr style="{{ (r.status != 'pending' and r.status != 'query') ? 'opacity: 0.65;' : '' }} cursor:pointer;"
                            class="detail-row"
                            data-info="{{ data|json_encode|e('html_attr') }}"
                            title="Klicken für Details">
                            <td><strong style="color: var(--primary-color);">{{ r.aud_type|default('-') }}</strong></td>
                            <td style="font-weight: 600;">{{ r.teacher_name }} <span style="font-size: 0.8em; color: var(--text-muted);">({{ r.kuerzel }})</span></td>
                            <td>{{ r.event_date|date('d.m.Y') }}</td>
                            <td>{{ r.class_name }}</td>
                            <td>{{ r.destination }}</td>
                            <td onclick="event.stopPropagation();">
                                {% if r.status == 'pending' %}
                                    <form method="POST" action="/admin_action.php" style="display:inline-block; margin:0;" class="admin-action-form">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <input type="hidden" name="id" value="{{ r.id }}">
                                        <input type="hidden" name="type" value="ausflug">
                                        <button type="button" class="button-primary btn-approve" style="background-color: var(--success-color); padding: 5px 10px; font-size: 0.85em; margin-right: 5px;" title="Genehmigen">✓</button>
                                        <button type="button" class="button-warning btn-query" style="background-color: var(--warning-color); padding: 5px 10px; font-size: 0.85em; margin-right: 5px; color: white; border: none;" title="Rückfrage">❓</button>
                                        <button type="button" class="button-danger btn-reject" style="padding: 5px 10px; font-size: 0.85em;" title="Ablehnen">✗</button>
                                        <input type="hidden" name="action" value="" class="action-input">
                                    </form>
                                {% elseif r.status == 'query' %}
                                    <form method="POST" action="/admin_action.php" style="display:inline-block; margin:0;" class="admin-action-form">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <input type="hidden" name="id" value="{{ r.id }}">
                                        <input type="hidden" name="type" value="ausflug">
                                        <button type="button" class="button-primary btn-approve" style="background-color: var(--success-color); padding: 5px 10px; font-size: 0.85em; margin-right: 5px;" title="Genehmigen">✓</button>
                                        <button type="button" class="button-danger btn-reject" style="padding: 5px 10px; font-size: 0.85em;" title="Ablehnen">✗</button>
                                        <input type="hidden" name="action" value="" class="action-input">
                                    </form>
                                    <div style="margin-top: 5px;"><span class="badge" style="background-color: var(--warning-color); color: white; font-size: 0.75em;">RÜCKFRAGE</span></div>
                                {% else %}
                                    {% set statusColor = (r.status == 'approved') ? 'var(--success-color)' : 'var(--danger-color)' %}
                                    {% set statusText = (r.status == 'approved') ? 'GENEHMIGT' : 'ABGELEHNT' %}
                                    <span style="color: {{ statusColor }}; font-weight: 600; font-size: 0.85em;">{{ statusText }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# =====================================================================
   SECTION 4: Lehrerverwaltung
   ===================================================================== #}
<div class="content-box" style="margin-top: 2rem;">
    <h3 style="border-left: 4px solid #8e44ad; padding-left: 10px;">Lehrerverwaltung (CSV Import)</h3>
    <p style="color: var(--text-muted); margin-bottom: 15px;">
        Importiere Lehrkräfte aus einer CSV-Datei. Erwartetes Format: <strong>Kürzel;Name;Email</strong> (erste Zeile wird als Überschrift ignoriert). Bei bereits existierenden Kürzeln werden Einträge übersprungen.
    </p>
    <form method="POST" action="/admin_dashboard.php" enctype="multipart/form-data" class="modern-form" style="max-width: 500px;">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div class="form-group">
            <label for="teacher_csv" class="form-label">CSV-Datei auswählen:</label>
            <input type="file" name="teacher_csv" id="teacher_csv" accept=".csv" required class="form-control" style="padding: 10px; border: 1px dashed var(--border-color); width: 100%;">
        </div>
        <div style="margin-top: 15px;">
            <button type="submit" class="button-primary" style="background-color: #8e44ad; width: auto;">📤 Importieren</button>
        </div>
    </form>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Handle teacher history dropdown visibility
        var historySelect = document.getElementById('history_teacher_select');
        if (historySelect) {
            historySelect.addEventListener('change', function() {
                // Hide all
                document.querySelectorAll('.history-teacher-block').forEach(function(el) {
                    el.style.display = 'none';
                });
                // Show selected
                if (this.value !== "") {
                    var target = document.getElementById(this.value);
                    if (target) {
                        target.style.display = 'block';
                    }
                }
            });
        }

        // Ensure global access for copyAudContent function
        window.copyAudContent = function(elementId) {
            var el = document.getElementById(elementId);
            if (!el) return;
            // Un-hide temporarily if hidden
            var displayWas = el.style.display;
            if(displayWas === 'none') {
                el.style.display = 'block';
            }
            el.select();
            el.setSelectionRange(0, 99999);
            try {
                document.execCommand('copy');
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'In die Zwischenablage kopiert!',
                    showConfirmButton: false,
                    timer: 2000
                });
            } catch (err) {
                console.error('Oops, unable to copy');
            }
            if(displayWas === 'none') {
                el.style.display = 'none';
            }
        };
    });

// ── Helper to build a detail row ────────────────────────────────────────────
function row(label, value) {
    if (!value && value !== 0) return '';
    return `<div style="display:grid;grid-template-columns:140px 1fr;gap:6px;padding:8px 0;border-bottom:1px solid var(--border-color,#eee);">
        <span style="font-size:0.8em;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;">${label}</span>
        <span>${value}</span>
    </div>`;
}

function badge(ok) {
    return ok ? `<span style="color:var(--success-color);font-weight:600;">✓ Ja</span>` : `<span style="color:var(--text-muted);">– Nein</span>`;
}

// ── Open panel ───────────────────────────────────────────────────────────────
function openDetailPanel(d) {
    let title = 'Freistellungsantrag';
    let body = '';

    if (d.type === 'freistellung') {
        title = 'Antrag auf Freistellung';
        body += row('Lehrkraft', d.teacher);
        body += row('Zeitraum', `${d.date_from} – ${d.date_to}`);
        body += row('Art / Grund', d.reason_type);
        body += row('Tage', d.days_of_week);
        body += row('Klassen', d.classes);
        if (d.hourly) {
            body += row('Stundenweise', `${d.hour_from}. bis ${d.hour_to}. Stunde`);
        }
        body += row('Begründung', d.reason);
    } else {
        title = 'Außerunterrichtliche Veranstaltung';
        body += row('Lehrkraft', d.teacher);
        body += row('Als', d.role);
        body += row('Klasse(n)', d.class_name);
        body += row('Begleitperson', d.companion);
        body += row('Datum', d.event_date);
        body += row('Veranstaltung', d.event_name);
        body += row('Ziel / Strecke', d.destination);
        body += row('Kosten ca.', d.costs);
        body += row('Verkehrsmittel', d.transport);
        if (d.start_time) body += row('Beginn', `${d.start_time} Uhr, ${d.start_location||'—'}`);
        if (d.return_time) body += row('Rückkehr', `${d.return_time} Uhr, ${d.return_location||'—'}`);
        body += row('Heimfahrt geregelt', badge(d.return_trip_arranged));
        body += row('Aufsicht', d.supervisors);
        body += row('Einverständniserklärung', d.consent_form ? `<strong>${d.consent_form.toUpperCase()}</strong>` : '—');
        body += row('Stundenplan benachrichtigt', badge(d.schedule_notified));
    }

    const statusColor = d.status === 'approved' ? 'var(--success-color)' : (d.status === 'rejected' ? 'var(--danger-color)' : (d.status === 'query' ? 'var(--warning-color)' : 'var(--text-muted)'));
    const statusText = d.status === 'approved' ? 'GENEHMIGT' : (d.status === 'rejected' ? 'ABGELEHNT' : (d.status === 'query' ? 'RÜCKFRAGE' : 'AUSSTEHEND'));
    body += row('Status', `<span style="color:${statusColor};font-weight:700;">${statusText}</span>`);

    document.getElementById('panel-title').textContent = title;
    document.getElementById('panel-body').innerHTML = body;
    document.getElementById('panel-actions').innerHTML = '';

    const panel = document.getElementById('detail-panel');
    const overlay = document.getElementById('detail-overlay');
    panel.style.display = 'block';
    overlay.style.display = 'block';
    requestAnimationFrame(() => { panel.style.transform = 'translateX(0)'; });
}

function closeDetailPanel() {
    const panel = document.getElementById('detail-panel');
    panel.style.transform = 'translateX(100%)';
    setTimeout(() => {
        panel.style.display = 'none';
        document.getElementById('detail-overlay').style.display = 'none';
    }, 300);
}

document.addEventListener("DOMContentLoaded", function() {
    // Click on any detail row → open panel
    document.querySelectorAll('.detail-row').forEach(row => {
        row.style.cursor = 'pointer';
        row.addEventListener('click', function() {
            const d = JSON.parse(this.dataset.info);
            openDetailPanel(d);
        });
    });

    // Handle approve buttons
    document.querySelectorAll('.btn-approve').forEach(button => {
        button.addEventListener('click', function(e) {
            const form = this.closest('form');
            form.querySelector('.action-input').value = 'approve';
            Swal.fire({
                title: 'Genehmigen?',
                text: "Soll dieser Antrag wirklich genehmigt werden?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: 'var(--success-color)',
                cancelButtonColor: 'var(--text-muted)',
                confirmButtonText: 'Ja, genehmigen',
                cancelButtonText: 'Abbrechen'
            }).then((result) => {
                if (result.isConfirmed) { form.submit(); }
            });
        });
    });

    // Handle reject buttons
    document.querySelectorAll('.btn-reject').forEach(button => {
        button.addEventListener('click', function(e) {
            const form = this.closest('form');
            form.querySelector('.action-input').value = 'reject';
            Swal.fire({
                title: 'Ablehnen?',
                text: "Soll dieser Antrag wirklich abgelehnt werden? Dies kann nicht rückgängig gemacht werden.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: 'var(--danger-color)',
                cancelButtonColor: 'var(--text-muted)',
                confirmButtonText: 'Ja, ablehnen',
                cancelButtonText: 'Abbrechen'
            }).then((result) => {
                if (result.isConfirmed) { form.submit(); }
            });
        });
    });

    // Handle query buttons
    document.querySelectorAll('.btn-query').forEach(button => {
        button.addEventListener('click', function(e) {
            const form = this.closest('form');
            form.querySelector('.action-input').value = 'query';
            Swal.fire({
                title: 'Rücksprache halten?',
                text: "Soll die Lehrkraft zu einer Rücksprache mit der Schulleitung aufgefordert werden? Der Antrag bleibt im System sichtbar.",
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: 'var(--warning-color)',
                cancelButtonColor: 'var(--text-muted)',
                confirmButtonText: 'Ja, Rückfrage stellen',
                cancelButtonText: 'Abbrechen'
            }).then((result) => {
                if (result.isConfirmed) { form.submit(); }
            });
        });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDetailPanel();
    });
});
</script>
{% endblock %}
