{% extends "base.twig" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Systemverwaltung & Datenpflege</h2>
    <a href="/admin_dashboard.php" class="btn" style="border: 1px solid var(--border-color); color: var(--text-dark); padding: 8px 16px; border-radius: 6px; text-decoration: none;">&larr; Zurück</a>
</div>

{# =====================================================================
   SECTION: Lehrerverwaltung (CSV Import)
   ===================================================================== #}
<div class="content-box">
    <h3 style="border-left: 4px solid #8e44ad; padding-left: 10px;">Lehrkräfte CSV-Import</h3>
    <p style="color: var(--text-muted); margin-bottom: 15px;">
        Importiert Lehrkräfte aus einer CSV-Datei mit den Spalten
        <strong>Kürzel, Nachname, Vorname, E-Mail</strong>. Die Reihenfolge ist egal, solange die erste Zeile
        die Spalten benennt – danach richtet sich der Import. Angezeigt wird später „Vorname Nachname“.
    </p>
    <details style="margin-bottom: 15px; font-size: 0.9em; color: var(--text-muted);">
        <summary style="cursor: pointer; font-weight: 600; color: var(--primary-color);">Beispiel und Hinweise</summary>
        <pre style="background: var(--bg-main); padding: 12px; border-radius: 6px; margin: 10px 0; overflow-x: auto; font-size: 0.9em;">Kürzel;Nachname;Vorname;E-Mail
SOM;Sommer;Anna;anna.sommer@schule.de
WIN;Winter;Bernd;bernd.winter@schule.de</pre>
        <ul style="margin: 0; padding-left: 20px; line-height: 1.7;">
            <li>Semikolon und Komma werden beide als Trennzeichen erkannt.</li>
            <li>Dateien aus Excel funktionieren auch mit Umlauten – die Kodierung wird umgewandelt.</li>
            <li>Das ältere Format <code>Kürzel;Name;E-Mail</code> wird weiterhin gelesen.</li>
            <li>Bereits vorhandene Kürzel werden übersprungen, nichts wird überschrieben.</li>
            <li>Das Passwort neuer Zugänge ist <code>lehrer</code> und muss bei der ersten Anmeldung geändert werden.</li>
        </ul>
    </details>
    <form method="POST" action="/admin_system.php" enctype="multipart/form-data" class="modern-form" style="max-width: 500px;">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div class="form-group">
            <label for="teacher_csv" class="form-label">CSV-Datei auswählen:</label>
            <input type="file" name="teacher_csv" id="teacher_csv" accept=".csv" required class="form-control" style="padding: 10px; border: 1px dashed var(--border-color); width: 100%;">
        </div>
        <div style="margin-top: 15px;">
            <button type="submit" class="button-primary" style="background-color: #8e44ad; width: auto;">Import starten</button>
        </div>
    </form>
</div>

{# =====================================================================
   ABSCHNITT: Kalender-Feeds
   ===================================================================== #}
<div class="content-box">
    <h3 style="border-left: 4px solid #3498db; padding-left: 10px;">Kalender im Schulkalender</h3>
    <p style="color: var(--text-muted); margin-bottom: 15px;">
        Externe Kalender werden im Schulkalender neben Krankmeldungen und genehmigten Abwesenheiten angezeigt.
        Nötig ist die Adresse eines iCal-Feeds (endet meist auf <code>.ics</code> oder trägt einen Schlüssel als Parameter).
        Bei IServ findet man sie unter <em>Kalender → Verwaltung → Veröffentlichen</em>.
    </p>

    {% if calendar_feeds is empty %}
        <p style="color: var(--text-muted); padding: 20px; text-align: center; background: var(--bg-main); border-radius: 6px; margin-bottom: 20px;">
            Noch kein Kalender eingetragen.
        </p>
    {% else %}
        <div style="overflow-x: auto; margin-bottom: 20px;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="text-align: left; border-bottom: 2px solid var(--border-color);">
                        <th style="padding: 10px;">Name</th>
                        <th style="padding: 10px;">Adresse</th>
                        <th style="padding: 10px;">Letzter Abruf</th>
                        <th style="padding: 10px; text-align: right;">Aktion</th>
                    </tr>
                </thead>
                <tbody>
                    {% for feed in calendar_feeds %}
                        <tr style="border-bottom: 1px solid var(--border-color);">
                            <td style="padding: 10px;">
                                <strong>{{ feed.name }}</strong>
                                {% if not feed.is_active %}
                                    <span style="margin-left: 6px; font-size: 0.75em; font-weight: 700; background: var(--bg-main); color: var(--text-muted); padding: 2px 8px; border-radius: 10px;">ausgeblendet</span>
                                {% endif %}
                            </td>
                            <td style="padding: 10px; font-size: 0.82em; color: var(--text-muted); max-width: 320px;">
                                {# Nur Rechnername und Pfad - der Schluessel in der Adresse ist ein Zugangsdatum. #}
                                <span title="Der vollständige Schlüssel wird aus Sicherheitsgründen nicht angezeigt.">
                                    {{ feed.url|split('?')|first }}{% if '?' in feed.url %}?…{% endif %}
                                </span>
                            </td>
                            <td style="padding: 10px; font-size: 0.85em;">
                                {% if feed.last_fetch_at %}
                                    {{ feed.last_fetch_at|date('d.m.Y, H:i') }}<br>
                                    <span style="color: {{ feed.last_status == 'OK' ? 'var(--primary-color)' : 'var(--danger-color)' }};">
                                        {{ feed.last_status == 'OK' ? feed.last_event_count ~ ' Termine' : feed.last_status }}
                                    </span>
                                {% else %}
                                    <span style="color: var(--text-muted);">noch nie</span>
                                {% endif %}
                            </td>
                            <td style="padding: 10px; text-align: right; white-space: nowrap;">
                                <form method="POST" action="/admin_system.php" style="display: inline;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <input type="hidden" name="action" value="test_calendar_feed">
                                    <input type="hidden" name="feed_id" value="{{ feed.id }}">
                                    <button type="submit" class="btn" style="background: var(--bg-main); border: 1px solid var(--border-color); color: var(--text-dark); padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 0.85em;">Prüfen</button>
                                </form>
                                <form method="POST" action="/admin_system.php" style="display: inline;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <input type="hidden" name="action" value="toggle_calendar_feed">
                                    <input type="hidden" name="feed_id" value="{{ feed.id }}">
                                    <button type="submit" class="btn" style="background: var(--bg-main); border: 1px solid var(--border-color); color: var(--text-dark); padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 0.85em;">{{ feed.is_active ? 'Ausblenden' : 'Einblenden' }}</button>
                                </form>
                                <form method="POST" action="/admin_system.php" style="display: inline;" onsubmit="return confirm('Kalender „{{ feed.name|e('js') }}“ wirklich entfernen?');">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <input type="hidden" name="action" value="delete_calendar_feed">
                                    <input type="hidden" name="feed_id" value="{{ feed.id }}">
                                    <button type="submit" class="button-danger" style="padding: 5px 10px; border-radius: 4px; font-size: 0.85em;">Entfernen</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <form method="POST" action="/admin_system.php" class="modern-form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="action" value="add_calendar_feed">

        <div style="display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap;">
            <div class="form-group" style="flex: 0 1 220px; margin-bottom: 0;">
                <label for="feed_name" class="form-label">Name</label>
                <input type="text" name="feed_name" id="feed_name" required maxlength="120"
                       placeholder="z.B. IServ-Schulkalender"
                       class="form-control" style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 6px;">
            </div>
            <div class="form-group" style="flex: 1 1 320px; margin-bottom: 0;">
                <label for="feed_url" class="form-label">Adresse des Kalenders (iCal/ICS)</label>
                <input type="url" name="feed_url" id="feed_url" required maxlength="1000"
                       placeholder="https://…/calendar?key=…"
                       class="form-control" style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 6px;">
            </div>
            <button type="submit" class="button-primary" style="background-color: #3498db; width: auto; padding: 10px 20px;">Hinzufügen</button>
        </div>
        <p style="color: var(--text-muted); font-size: 0.85em; margin: 10px 0 0 0;">
            Die Adresse wird beim Speichern einmal abgerufen. Adressen ins interne Netz werden abgelehnt,
            weil der Server sie selbst aufruft.
        </p>
    </form>
</div>

{# =====================================================================
   SECTION: Jahresabschluss & Archivierung
   ===================================================================== #}
<div class="content-box">
    <h3 style="border-left: 4px solid #e67e22; padding-left: 10px;">Jahresabschluss & Archivierung</h3>
    <p style="color: var(--text-muted); font-size: 0.9em;">
        Am Ende eines Schuljahres können Sie hier alle Daten (Anträge, Krankmeldungen) exportieren und anschließend das Jahr bereinigen.
    </p>
    
    <div style="display: flex; gap: 20px; align-items: flex-end; flex-wrap: wrap; margin-top: 15px;">
        <div class="form-group" style="flex: 1; min-width: 200px; margin-bottom: 0;">
            <label for="archive_year_select" class="form-label">Jahr auswählen:</label>
            <select id="archive_year_select" class="form-control" style="background: white;">
                {% set current_year = "now"|date("Y") %}
                <option value="{{ current_year }}">{{ current_year }} (Aktuell)</option>
                <option value="{{ current_year - 1 }}">{{ current_year - 1 }}</option>
                <option value="{{ current_year - 2 }}">{{ current_year - 2 }}</option>
            </select>
        </div>
        
        <div style="flex: 2; display: flex; gap: 10px;">
            <button type="button" class="button-primary" onclick="window.location.href='/admin_archive.php?action=export&year=' + document.getElementById('archive_year_select').value" style="background-color: #3498db; width: auto;">
                Daten exportieren (.zip)
            </button>
            
            <form method="POST" action="/admin_archive.php?action=cleanup" id="cleanup-form">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="confirm_year" id="cleanup_year_input">
                <button type="button" class="button-danger" onclick="handleCleanupClick()" style="width: auto;">
                    Jahr löschen (Bereinigen)
                </button>
            </form>
        </div>
    </div>
</div>

<script>
function handleCleanupClick() {
    const year = document.getElementById('archive_year_select').value;
    Swal.fire({
        title: 'Daten für ' + year + ' löschen?',
        text: "Dies kann NICHT rückgängig gemacht werden! Stellen Sie sicher, dass Sie zuvor einen ZIP-Export erstellt haben.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: 'var(--danger-color)',
        cancelButtonColor: 'var(--text-muted)',
        confirmButtonText: 'Ja, unwiderruflich löschen',
        cancelButtonText: 'Abbrechen'
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById('cleanup_year_input').value = year;
            document.getElementById('cleanup-form').submit();
        }
    });
}
</script>
{% endblock %}
