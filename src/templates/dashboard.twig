{% extends "base.twig" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center;">
    <h1>Willkommen, {{ current_user_name }}</h1>
    <span style="color: var(--text-muted); font-size: 0.9em;">{{ current_date }}</span>
</div>

<p style="color: var(--text-muted); margin-bottom: 30px;">Hier verwalten Sie Ihre Anträge und Meldungen.</p>

<div class="kpi-grid">
    <div class="kpi-box">
        <span>Austehende außerunterr. Anträge</span>
        <strong>{{ pending_extra }}</strong>
    </div>
    <div class="kpi-box">
        <span>Ausstehende Freistellungen</span>
        <strong>{{ pending_exemptions }}</strong>
    </div>
    <div class="kpi-box">
        <span>Krankmeldungen (Letzte 30 Tage)</span>
        <strong>{{ recent_sick }}</strong>
    </div>
</div>

<div class="content-box" style="margin-top: 30px;">
    <h2>Schnellzugriff</h2>
    
    <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
        <a href="/antrag_ausserunterrichtlich.php" class="kpi-box" style="text-decoration: none; cursor: pointer; border-left: 5px solid var(--primary-color);">
            <div style="font-size: 2em; margin-bottom: 15px;">🚌</div>
            <span style="color: var(--text-dark); margin: 0; align-self: center;">Außerunterrichtliche<br>Veranstaltung</span>
        </a>

        <a href="/antrag_freistellung.php" class="kpi-box" style="text-decoration: none; cursor: pointer; border-left: 5px solid var(--warning-color);">
            <div style="font-size: 2em; margin-bottom: 15px;">🏖️</div>
            <span style="color: var(--text-dark); margin: 0; align-self: center;">Neuer Antrag:<br>Freistellung</span>
        </a>

        <a href="/krankmeldung.php" class="kpi-box" style="text-decoration: none; cursor: pointer; border-left: 5px solid var(--danger-color);">
            <div style="font-size: 2em; margin-bottom: 15px;">🤒</div>
            <span style="color: var(--text-dark); margin: 0; align-self: center;">Neue Meldung:<br>Krankmeldung</span>
        </a>
    </div>
</div>

{% if total_queries > 0 %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    Swal.fire({
        title: 'Rücksprache mit der Schulleitung',
        text: 'Es liegen {{ total_queries }} Anträge vor, zu denen die Schulleitung gerne mit dir Rücksprache halten würde. Bitte melde dich kurz im Sekretariat.',
        icon: 'info',
        confirmButtonColor: 'var(--primary-color)',
        confirmButtonText: 'Verstanden'
    });
});
</script>
{% endif %}

{% endblock %}
