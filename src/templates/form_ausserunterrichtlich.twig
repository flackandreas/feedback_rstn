{% extends "base.twig" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Antrag auf Genehmigung einer Dienstreise – Außerunterrichtliche Veranstaltung</h2>
    <a href="/index.php" class="button-secondary" style="text-decoration:none;">&larr; Zurück</a>
</div>
<p style="color: var(--text-muted); margin-bottom: 20px; font-style: italic;">Nach dem Vordruck LBV 1211. Spätestens 3 Tage vor der Durchführung bei der SL zu stellen.</p>

{# Die Abschnitte folgen dem Vordruck LBV 1211 (Stand 07/20), damit sich
   Formular und Ausdruck Zeile fuer Zeile vergleichen lassen. Was nur die
   Schule braucht, steht am Ende unter "Schulintern" und wird nicht gedruckt. #}
<div class="content-box">
    <form method="POST" action="/antrag_ausserunterrichtlich.php">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        {# ── 1. Persoenliche Angaben ─────────────────────────────────── #}
        <fieldset class="lbv-abschnitt">
            <legend class="lbv-abschnitt__titel">1. Persönliche Angaben</legend>

            {# "/DRM" steht auf dem Vordruck fest hinter dem Feld. #}
            <div class="form-group" style="max-width: 420px;">
                <label for="lbv_personalnummer">Personalnummer/Arbeitsgebiet *</label>
                <input type="text" id="lbv_personalnummer" name="lbv_personalnummer" value="{{ werte.lbv_personalnummer|default('') }}"
                       required maxlength="30" autocomplete="off" aria-describedby="pnr_hinweis">
                <small class="lbv-hinweis" id="pnr_hinweis">Wird in Ihrem Profil gespeichert und beim nächsten Antrag vorbelegt. Sehen können sie nur Sie und die Schulleitung.</small>
            </div>

            <p class="lbv-abschnitt__zwischentitel">Verantwortliche Lehrkraft</p>
            <div class="lbv-person">
                <div class="form-group">
                    <label for="lk_nachname">Nachname *</label>
                    <input type="text" id="lk_nachname" name="lk_nachname" value="{{ werte.lk_nachname|default('') }}" required maxlength="100">
                </div>
                <div class="form-group">
                    <label for="lk_vorname">Vorname *</label>
                    <input type="text" id="lk_vorname" name="lk_vorname" value="{{ werte.lk_vorname|default('') }}" required maxlength="100">
                </div>
                <label class="lbv-haken lbv-person__haken">
                    <input type="checkbox" name="lk_in_ausbildung" value="1" {% if werte.lk_in_ausbildung|default(0) %}checked{% endif %}>
                    in Ausbildung
                </label>
            </div>

            <p class="lbv-abschnitt__zwischentitel">
                Begleitpersonen
                <span class="lbv-hinweis">bis zu {{ begleitpersonen|length }} – aus dem Kollegium wählen oder frei eintragen, etwa für Eltern</span>
            </p>
            {% for p in begleitpersonen %}
                {% set n = loop.index %}
                <div class="lbv-person lbv-person--begleitung" data-begleitung>
                    <div class="form-group">
                        <label for="begleit_{{ n }}_wahl">Begleitperson {{ n }}</label>
                        <select id="begleit_{{ n }}_wahl" name="begleit[{{ n }}][teacher_id]" data-wahl>
                            <option value="">Frei eintragen</option>
                            {% for t in kollegium %}
                                <option value="{{ t.id }}" data-name="{{ t.name }}" {% if p.teacher_id == t.id %}selected{% endif %}>{{ t.name }} ({{ t.kuerzel }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="begleit_{{ n }}_nachname">Nachname</label>
                        <input type="text" id="begleit_{{ n }}_nachname" name="begleit[{{ n }}][nachname]" value="{{ p.nachname }}" maxlength="100" data-nachname>
                    </div>
                    <div class="form-group">
                        <label for="begleit_{{ n }}_vorname">Vorname</label>
                        <input type="text" id="begleit_{{ n }}_vorname" name="begleit[{{ n }}][vorname]" value="{{ p.vorname }}" maxlength="100" data-vorname>
                    </div>
                    <label class="lbv-haken lbv-person__haken">
                        <input type="checkbox" name="begleit[{{ n }}][in_ausbildung]" value="1" {% if p.in_ausbildung %}checked{% endif %}>
                        in Ausbildung
                    </label>
                </div>
            {% endfor %}
        </fieldset>

        {# ── 2. Angaben zur Dienstreise ──────────────────────────────── #}
        <fieldset class="lbv-abschnitt">
            <legend class="lbv-abschnitt__titel">2. Angaben zur Dienstreise</legend>

            <div class="form-grid-2">
                <div class="form-group">
                    <label for="role">Art der Veranstaltung *</label>
                    <input type="text" id="role" name="role" value="{{ werte.role|default('') }}" list="veranstaltungsarten" required maxlength="255"
                           placeholder="z. B. Wandertag, Schullandheimaufenthalt …">
                    <datalist id="veranstaltungsarten">
                        {% for art in veranstaltungsarten %}<option value="{{ art }}">{% endfor %}
                    </datalist>
                </div>
                <div class="form-group">
                    <label for="event_name">Veranstaltungsname für den Kalender</label>
                    <input type="text" id="event_name" name="event_name" value="{{ werte.event_name|default('') }}" maxlength="255"
                           placeholder="leer = Art der Veranstaltung">
                </div>
            </div>

            <div class="form-group">
                <label for="destination">Ziel (Ort, Stadt, Land) *</label>
                <input type="text" id="destination" name="destination" value="{{ werte.destination|default('') }}" required maxlength="255"
                       placeholder="z. B. Konstanz, Deutschland">
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    {% set gewaehlt = werte.class_names|default([]) %}
                    <label for="class_name">Klasse/Klassenstufe/Kurs *</label>
                    {% if all_classes|length > 0 %}
                        {# Mehrfachauswahl im Listenfeld statt Ankreuzfelder: die
                           Zahl der Klassen waechst, und eine Wand aus Kaestchen
                           wuerde das Formular sprengen. Auf dem Handy tippt man
                           die Eintraege einfach an, dort braucht es kein Strg. #}
                        <select id="class_name" name="class_name[]" multiple required
                                size="{{ min(all_classes|length + (selected_class_ids|length > 0 ? 2 : 0), 8) }}"
                                class="klassenwahl-liste" aria-describedby="klassen_hinweis">
                            {% if selected_class_ids|length > 0 %}
                                <optgroup label="Meine Klassen">
                                    {% for c in all_classes %}
                                        {% if c.id in selected_class_ids %}
                                            <option value="{{ c.name }}" {% if c.name in gewaehlt %}selected{% endif %}>{{ c.name }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </optgroup>
                                <optgroup label="Weitere Klassen">
                                    {% for c in all_classes %}
                                        {% if c.id not in selected_class_ids %}
                                            <option value="{{ c.name }}" {% if c.name in gewaehlt %}selected{% endif %}>{{ c.name }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </optgroup>
                            {% else %}
                                {% for c in all_classes %}
                                    <option value="{{ c.name }}" {% if c.name in gewaehlt %}selected{% endif %}>{{ c.name }}</option>
                                {% endfor %}
                            {% endif %}
                        </select>
                        <small class="klassenwahl__hinweis" id="klassen_hinweis">
                            Mehrere mit <kbd>Strg</kbd> anklicken, auf dem Mac mit <kbd>cmd</kbd>.
                            Am Handy genügt Antippen.
                            <span class="klassenwahl__gewaehlt" data-fuer="class_name"></span>
                        </small>
                    {% else %}
                        {# Die Klassen kommen aus dem Unterrichtsmodul. Fehlen sie,
                           bleibt das Formular benutzbar. #}
                        <input type="text" id="class_name" name="class_name[]"
                               value="{{ gewaehlt|join(', ') }}" required
                               placeholder="z. B. 8a, 8b">
                        <small class="klassenwahl__hinweis">Mehrere durch Komma trennen.</small>
                    {% endif %}
                </div>
                <div class="form-group">
                    <label for="schueler_anzahl">Zahl der teilnehmenden Schülerinnen und Schüler *</label>
                    <input type="number" id="schueler_anzahl" name="schueler_anzahl" value="{{ werte.schueler_anzahl|default('') }}"
                           required min="1" max="9999" step="1" inputmode="numeric">
                </div>
            </div>

            <div class="lbv-zeitpunkte" role="group" aria-label="Reisezeiten">
                {% set zeitpunkte = [
                    {titel: 'Beginn der Reise', datum: 'event_date', zeit: 'start_time'},
                    {titel: 'Ankunft am Veranstaltungsort', datum: 'ankunft_datum', zeit: 'ankunft_zeit'},
                    {titel: 'Abfahrt am Veranstaltungsort', datum: 'abfahrt_datum', zeit: 'abfahrt_zeit'},
                    {titel: 'Ende der Reise', datum: 'event_date_to', zeit: 'return_time'}
                ] %}
                {% for z in zeitpunkte %}
                    <div class="lbv-zeitpunkt">
                        <span class="lbv-zeitpunkt__titel">{{ z.titel }} *</span>
                        <div class="form-group">
                            <label for="{{ z.datum }}">Datum</label>
                            <input type="date" id="{{ z.datum }}" name="{{ z.datum }}" value="{{ attribute(werte, z.datum)|default('') }}" required>
                        </div>
                        <div class="form-group">
                            <label for="{{ z.zeit }}">Uhrzeit</label>
                            <input type="time" id="{{ z.zeit }}" name="{{ z.zeit }}" value="{{ attribute(werte, z.zeit)|default('') }}" required>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="form-group" style="max-width: 320px;">
                <label for="aufenthaltstage">Zahl der Aufenthaltstage</label>
                <input type="number" id="aufenthaltstage" name="aufenthaltstage" value="{{ werte.aufenthaltstage|default('') }}"
                       min="1" max="366" step="1" inputmode="numeric" aria-describedby="tage_hinweis">
                <small class="lbv-hinweis" id="tage_hinweis">Wird aus Beginn und Ende der Reise berechnet und lässt sich ändern.</small>
            </div>
        </fieldset>

        {# ── 3. Befoerderungsmittel ──────────────────────────────────── #}
        <fieldset class="lbv-abschnitt">
            <legend class="lbv-abschnitt__titel">3. Beförderungsmittel *</legend>
            <p class="lbv-hinweis" style="margin-top: 0;">Ich beabsichtige, die Dienstreise mit folgendem/n Beförderungsmittel/n durchzuführen – mindestens eines, mehrere sind möglich:</p>
            <label class="lbv-haken">
                <input type="checkbox" name="bef_oepnv" value="1" data-bef {% if werte.bef_oepnv|default(0) %}checked{% endif %}>
                mit einem regelmäßig verkehrenden Beförderungsmittel (z. B. S-Bahn, U-Bahn, Zug, Bus)
            </label>
            <label class="lbv-haken">
                <input type="checkbox" name="bef_reisebus" value="1" data-bef {% if werte.bef_reisebus|default(0) %}checked{% endif %}>
                mit dem Reisebus
            </label>
            <label class="lbv-haken">
                <input type="checkbox" id="bef_sonstiges" name="bef_sonstiges" value="1" data-bef {% if werte.bef_sonstiges|default(0) %}checked{% endif %}>
                mit einem sonstigen Verkehrsmittel
            </label>
            <div class="form-group" id="bef_sonstiges_feld" style="margin-top: 10px;">
                <label for="bef_sonstiges_text">Art und Gründe *</label>
                <textarea id="bef_sonstiges_text" name="bef_sonstiges_text" rows="2" maxlength="1000"
                          aria-describedby="bef_hinweis">{{ werte.bef_sonstiges_text|default('') }}</textarea>
                <small class="lbv-hinweis" id="bef_hinweis">Steht auf dem Ausdruck unter „Erläuterungen“.</small>
            </div>
        </fieldset>

        {# ── 4. Voraussichtliche Kosten ──────────────────────────────── #}
        <fieldset class="lbv-abschnitt">
            <legend class="lbv-abschnitt__titel">4. Voraussichtliche Kosten</legend>
            <div class="form-grid-2">
                <div class="form-group">
                    <label for="lbv_kosten_eur">Insgesamt in EUR für Lehrkraft und Begleitpersonen *</label>
                    <input type="text" id="lbv_kosten_eur" name="lbv_kosten_eur" value="{{ werte.lbv_kosten_eur|default('')|replace({'.': ','}) }}"
                           required inputmode="decimal" pattern="\d{1,6}([.,]\d{1,2})?" placeholder="z. B. 360 oder 360,50"
                           aria-describedby="kosten_hinweis">
                    <small class="lbv-hinweis" id="kosten_hinweis">Unter Berücksichtigung von Freiplätzen. Beiträge der Schülerinnen und Schüler gehören nicht hierher.</small>
                </div>
                <div class="form-group">
                    <label for="lbv_kosten_erlaeuterung">Kurze Erläuterung</label>
                    <input type="text" id="lbv_kosten_erlaeuterung" name="lbv_kosten_erlaeuterung" value="{{ werte.lbv_kosten_erlaeuterung|default('') }}"
                           maxlength="100" placeholder="z. B. 2 × 180 €" aria-describedby="erlaeuterung_hinweis">
                    <small class="lbv-hinweis" id="erlaeuterung_hinweis">Wird neben den Betrag gedruckt.</small>
                </div>
            </div>
        </fieldset>

        <p class="lbv-hinweis lbv-hinweis--kasten">
            Abschnitt 5 (Erklärungen) unterschreiben Sie auf dem Ausdruck von Hand. Abschnitt 6 ist der Genehmigung
            durch die Schulleitung vorbehalten. Der Schulkopf bleibt für den Schulstempel frei.
        </p>

        {# ── Schulintern ─────────────────────────────────────────────── #}
        <fieldset class="lbv-abschnitt lbv-abschnitt--intern">
            <legend class="lbv-abschnitt__titel">Schulintern <span class="lbv-hinweis">– wird nicht gedruckt</span></legend>
            <div class="form-grid-3">
                <div class="form-group">
                    <label for="costs">Kosten je Schülerin/Schüler ca.</label>
                    <input type="text" id="costs" name="costs" value="{{ werte.costs|default('') }}" maxlength="100" placeholder="z. B. 12 €">
                </div>
                <div class="form-group">
                    <label for="start_location">Treffpunkt bei Beginn</label>
                    <input type="text" id="start_location" name="start_location" value="{{ werte.start_location|default('') }}" maxlength="255" placeholder="z. B. Schulhof">
                </div>
                <div class="form-group">
                    <label for="return_location">Treffpunkt bei Rückkehr</label>
                    <input type="text" id="return_location" name="return_location" value="{{ werte.return_location|default('') }}" maxlength="255" placeholder="z. B. Schulhof">
                </div>
            </div>

            <label class="lbv-haken">
                <input type="checkbox" name="return_trip_arranged" value="1" {% if werte.return_trip_arranged|default(0) %}checked{% endif %}>
                <strong>Die Heimfahrtmöglichkeiten für die Schüler sind geregelt.</strong>
            </label>

            <div class="form-group" style="margin-top: 15px;">
                <label>Eine Einverständniserklärung liegt vor</label>
                <div style="display: flex; gap: 20px; margin-top: 8px;">
                    <label style="font-weight: normal;"><input type="radio" name="consent_form" value="ja" {% if werte.consent_form|default('') == 'ja' %}checked{% endif %}> Ja</label>
                    <label style="font-weight: normal;"><input type="radio" name="consent_form" value="nein" {% if werte.consent_form|default('') == 'nein' %}checked{% endif %}> Nein</label>
                </div>
            </div>
        </fieldset>

        <div style="margin-top: 30px; text-align: right;">
            {% if edit_request %}
                <input type="hidden" name="edit_id" value="{{ edit_request.id }}">
                <button type="submit" class="button-primary">Änderungen speichern</button>
            {% else %}
                <button type="submit" class="button-primary">Antrag einreichen</button>
            {% endif %}
        </div>
    </form>
</div>

<!-- History log preview -->
<div class="content-box">
    <h3>Ihre letzten Anträge</h3>
    {% if requests is empty %}
        <p style='color: var(--text-muted);'>Noch keine Anträge gestellt.</p>
    {% else %}
        <table class='data-table simple'>
            <thead>
                <tr>
                    <th>Klasse</th>
                    <th>Ziel</th>
                    <th>Datum</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for r in requests %}
                    {% set statusColor = (r.status == 'pending' or r.status == 'query') ? 'var(--warning-color)' : ((r.status == 'approved') ? 'var(--success-color)' : 'var(--danger-color)') %}
                    {% set statusText %}
                        {% if r.status == 'pending' %}AUSSTEHEND{% elseif r.status == 'query' %}RÜCKFRAGE{% elseif r.status == 'approved' %}GENEHMIGT{% elseif r.status == 'rejected' %}ABGELEHNT{% else %}{{ r.status|upper }}{% endif %}
                    {% endset %}
                    <tr>
                        <td>{{ r.class_name }}</td>
                        <td>{{ r.destination }}</td>
                        <td>
                            {% if r.event_date_to and r.event_date_to != r.event_date %}
                                {{ r.event_date|date('d.m.Y') }} - {{ r.event_date_to|date('d.m.Y') }}
                            {% else %}
                                {{ r.event_date|date('d.m.Y') }}
                            {% endif %}
                        </td>
                        <td><span style='color: {{ statusColor }}; font-weight: 600;'>{{ statusText|trim }}</span></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}

{% block extra_scripts %}
<script>
document.addEventListener("DOMContentLoaded", function() {
    function feld(id) { return document.getElementById(id); }

    // Reisezeiten: Ankunft, Abfahrt und Ende koennen nicht vor dem Beginn
    // liegen. Leere Felder bekommen einen Vorschlag - Ankunft am Tag des
    // Beginns, Abfahrt am Tag des Endes -, gepruefte Werte bleiben stehen.
    var beginn = feld('event_date'), ankunft = feld('ankunft_datum'),
        abfahrt = feld('abfahrt_datum'), ende = feld('event_date_to'),
        tage = feld('aufenthaltstage');

    // Aufenthaltstage: Beginn und Ende mitgezaehlt. Ueberschrieben wird nur
    // ein leeres Feld oder der eigene letzte Vorschlag, nie eine Eingabe.
    var letzterVorschlag = null;
    function tageVorschlagen() {
        if (!beginn.value || !ende.value) { return; }
        var a = new Date(beginn.value + 'T00:00:00'), b = new Date(ende.value + 'T00:00:00');
        var n = Math.round((b - a) / 86400000) + 1;
        if (n < 1) { return; }
        if (tage.value === '' || tage.value === String(letzterVorschlag)) {
            tage.value = n;
        }
        letzterVorschlag = n;
    }

    function zeitenAbgleichen() {
        [ankunft, abfahrt, ende].forEach(function (f) { f.min = beginn.value; });
        if (beginn.value) {
            if (!ende.value || ende.value < beginn.value) { ende.value = beginn.value; }
            if (!ankunft.value) { ankunft.value = beginn.value; }
        }
        if (ende.value) {
            [ankunft, abfahrt].forEach(function (f) { f.max = ende.value; });
            if (!abfahrt.value) { abfahrt.value = ende.value; }
        }
        tageVorschlagen();
    }

    if (beginn && ende && tage) {
        // Ein beim Laden schon stehender Wert gilt als Eingabe, solange er
        // nicht dem errechneten entspricht.
        if (beginn.value && ende.value) {
            var a0 = new Date(beginn.value + 'T00:00:00'), b0 = new Date(ende.value + 'T00:00:00');
            letzterVorschlag = Math.round((b0 - a0) / 86400000) + 1;
        }
        beginn.addEventListener('change', zeitenAbgleichen);
        ende.addEventListener('change', zeitenAbgleichen);
        if (beginn.value) { [ankunft, abfahrt, ende].forEach(function (f) { f.min = beginn.value; }); }
        if (ende.value) { [ankunft, abfahrt].forEach(function (f) { f.max = ende.value; }); }
        tageVorschlagen();
    }

    // Begleitperson aus dem Kollegium: Name und Vorname aus dem Konto
    // vorschlagen, geteilt am letzten Leerzeichen wie im Controller.
    document.querySelectorAll('[data-begleitung]').forEach(function (zeile) {
        var wahl = zeile.querySelector('[data-wahl]');
        wahl.addEventListener('change', function () {
            var option = wahl.selectedOptions[0];
            var name = option ? (option.dataset.name || '') : '';
            if (!name) { return; }
            var stelle = name.lastIndexOf(' ');
            zeile.querySelector('[data-nachname]').value = stelle < 0 ? name : name.slice(stelle + 1);
            zeile.querySelector('[data-vorname]').value = stelle < 0 ? '' : name.slice(0, stelle);
        });
    });

    // Befoerderungsmittel: mindestens eines. Die Meldung haengt am ersten
    // Kaestchen, damit der Browser sie beim Absenden dort zeigt.
    var bef = Array.from(document.querySelectorAll('[data-bef]'));
    var sonstiges = feld('bef_sonstiges'), sonstigesFeld = feld('bef_sonstiges_feld'), sonstigesText = feld('bef_sonstiges_text');
    function befPruefen() {
        var eines = bef.some(function (b) { return b.checked; });
        bef[0].setCustomValidity(eines ? '' : 'Bitte mindestens ein Beförderungsmittel ankreuzen.');
        sonstigesFeld.style.display = sonstiges.checked ? '' : 'none';
        sonstigesText.required = sonstiges.checked;
    }
    bef.forEach(function (b) { b.addEventListener('change', befPruefen); });
    befPruefen();

    // Gewaehlte Klassen mitschreiben. In einem Listenfeld mit vielen
    // Eintraegen sieht man sonst nur den sichtbaren Ausschnitt und weiss
    // nicht, was weiter oben noch angeklickt ist.
    document.querySelectorAll('.klassenwahl__gewaehlt').forEach(function (anzeige) {
        var liste = document.getElementById(anzeige.dataset.fuer);
        if (!liste) { return; }

        function schreibe() {
            var namen = Array.from(liste.selectedOptions).map(function (o) { return o.value; });
            if (namen.length === 0) {
                anzeige.textContent = '';
                return;
            }
            anzeige.textContent = namen.length === 1
                ? 'Gewählt: ' + namen[0]
                : 'Gewählt (' + namen.length + '): ' + namen.join(', ');
        }

        liste.addEventListener('change', schreibe);
        schreibe();
    });
});
</script>
{% endblock %}
