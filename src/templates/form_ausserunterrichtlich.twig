{% extends "base.twig" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Antrag auf außerunterrichtliche Veranstaltung</h2>
    <a href="/index.php" class="button-secondary" style="text-decoration:none;">&larr; Zurück</a>
</div>

<div class="content-box">
    <form method="POST" action="/antrag_ausserunterrichtlich.php">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <div class="form-grid-2">
            <div class="form-group">
                <label for="class_name">Klasse(n) *</label>
                <input type="text" id="class_name" name="class_name" required placeholder="z.B. 8a, 8b">
            </div>

            <div class="form-group">
                <label for="event_date">Datum der Veranstaltung *</label>
                <input type="date" id="event_date" name="event_date" required>
            </div>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label for="destination">Reiseziel / Ort *</label>
            <input type="text" id="destination" name="destination" required placeholder="Wohin geht der Ausflug?">
        </div>

        <div class="form-grid-2" style="margin-top: 15px;">
            <div class="form-group">
                <label for="aud_type">Art (AUD) *</label>
                <select id="aud_type" name="aud_type" required>
                    <option value="">Bitte wählen</option>
                    <option value="AUD 1">AUD 1</option>
                    <option value="AUD 2">AUD 2</option>
                    <option value="AUD 3">AUD 3</option>
                    <option value="AUD 4">AUD 4</option>
                    <option value="AUD 6">AUD 6</option>
                    <option value="AUD 7">AUD 7</option>
                </select>
            </div>

            <div class="form-group">
                <label for="participating_teacher_id">Begleitende Lehrkraft (Optional)</label>
                <select id="participating_teacher_id" name="participating_teacher_id">
                    <option value="">Keine / Bitte wählen</option>
                    {% for teacher in all_teachers %}
                        <option value="{{ teacher.id }}">{{ teacher.name }} ({{ teacher.kuerzel }})</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div style="margin-top: 25px; text-align: right;">
            <button type="submit" class="button-primary">Antrag einreichen</button>
        </div>
    </form>
</div>

<!-- History log preview -->
<div class="content-box">
    <h3>Ihre letzten Anträge</h3>
    {% if requests is empty %}
        <p style='color: var(--text-muted);'>Noch keine Anträge gestellt.</p>
    {% else %}
        <table class='data-table simple'>
            <thead>
                <tr>
                    <th>Klasse</th>
                    <th>Ziel</th>
                    <th>AUD</th>
                    <th>Datum</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for r in requests %}
                    {% set statusColor = (r.status == 'pending') ? 'var(--warning-color)' : ((r.status == 'approved') ? 'var(--success-color)' : 'var(--danger-color)') %}
                    
                    {% set statusText %}
                        {% if r.status == 'pending' %}AUSSTEHEND{% elseif r.status == 'approved' %}GENEHMIGT{% elseif r.status == 'rejected' %}ABGELEHNT{% else %}{{ r.status|upper }}{% endif %}
                    {% endset %}
                    
                    <tr>
                        <td>{{ r.class_name }}</td>
                        <td>{{ r.destination }}</td>
                        <td>{{ r.aud_type }}</td>
                        <td>{{ r.event_date|date('d.m.Y') }}</td>
                        <td><span style='color: {{ statusColor }}; font-weight: 600;'>{{ statusText|trim }}</span></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}
