{% extends "base.twig" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Antrag auf Freistellung</h2>
    <a href="/index.php" class="button-secondary" style="text-decoration:none;">&larr; Zurück</a>
</div>

<div class="content-box">
    <form method="POST" action="/antrag_freistellung.php">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <div class="form-grid-2">
            <div class="form-group">
                <label for="date_from">Von (Datum) *</label>
                <input type="date" id="date_from" name="date_from" required>
            </div>

            <div class="form-group">
                <label for="date_to">Bis (Datum) *</label>
                <input type="date" id="date_to" name="date_to" required>
            </div>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label>Tage *</label>
            <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 5px;">
                <label style="font-weight: normal;"><input type="checkbox" name="days_of_week[]" value="Montag"> Montag</label>
                <label style="font-weight: normal;"><input type="checkbox" name="days_of_week[]" value="Dienstag"> Dienstag</label>
                <label style="font-weight: normal;"><input type="checkbox" name="days_of_week[]" value="Mittwoch"> Mittwoch</label>
                <label style="font-weight: normal;"><input type="checkbox" name="days_of_week[]" value="Donnerstag"> Donnerstag</label>
                <label style="font-weight: normal;"><input type="checkbox" name="days_of_week[]" value="Freitag"> Freitag</label>
            </div>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label for="classes">Beteiligte Klasse</label>
            <select id="classes" name="classes">
                <option value="">Keine / Bitte wählen</option>
                {% for c in all_classes %}
                    <option value="{{ c.name }}">{{ c.name }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label style="font-weight: normal;">
                <input type="checkbox" id="hourly_exemption_check" name="hourly_exemption" value="1"> 
                <strong>Stundenweise Freistellung</strong>
            </label>
            
            <div id="hourly_inputs" style="display: none; margin-top: 10px; padding: 10px; background: var(--bg-color); border-radius: 4px; border: 1px solid var(--border-color);">
                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="hour_from">Von Stunde</label>
                        <input type="number" id="hour_from" name="hour_from" min="1" max="12">
                    </div>
                    <div class="form-group">
                        <label for="hour_to">Bis Stunde</label>
                        <input type="number" id="hour_to" name="hour_to" min="1" max="12">
                    </div>
                </div>
            </div>
        </div>
        
        <div class="form-group" style="margin-top: 15px;">
            <label>Grund der Freistellung *</label>
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 5px;">
                <label style="font-weight: normal;"><input type="radio" name="reason_type" value="Außerunterrichtliche Veranstaltungen" required> Außerunterrichtliche Veranstaltungen</label>
                <label style="font-weight: normal;"><input type="radio" name="reason_type" value="Dienstliche Veranstaltung" required> Dienstliche Veranstaltung</label>
                <label style="font-weight: normal;"><input type="radio" name="reason_type" value="Sonderurlaub" required> Sonderurlaub</label>
                <label style="font-weight: normal;"><input type="radio" name="reason_type" value="Krankheit" required> Krankheit</label>
            </div>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label for="reason">Begründung *</label>
            <textarea id="reason" name="reason" rows="4" required placeholder="Bitte geben Sie hier Ihre Gründe an..."></textarea>
        </div>

        <div style="margin-top: 25px; text-align: right;">
            <button type="submit" class="button-primary">Antrag einreichen</button>
        </div>
    </form>
</div>

<!-- History log preview -->
<div class="content-box">
    <h3>Ihre letzten Anträge</h3>
    {% if requests is empty %}
        <p style='color: var(--text-muted);'>Noch keine Anträge gestellt.</p>
    {% else %}
        <table class='data-table simple'>
            <thead>
                <tr>
                    <th>Von</th>
                    <th>Bis</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for r in requests %}
                    {% set statusColor = (r.status == 'pending') ? 'var(--warning-color)' : ((r.status == 'approved') ? 'var(--success-color)' : 'var(--danger-color)') %}
                    {% set statusText %}
                        {% if r.status == 'pending' %}AUSSTEHEND{% elseif r.status == 'approved' %}GENEHMIGT{% elseif r.status == 'rejected' %}ABGELEHNT{% else %}{{ r.status|upper }}{% endif %}
                    {% endset %}
                    <tr>
                        <td>{{ r.date_from|date('d.m.Y') }}</td>
                        <td>{{ r.date_to|date('d.m.Y') }}</td>
                        <td><span style='color: {{ statusColor }}; font-weight: 600;'>{{ statusText|trim }}</span></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const hourlyCheck = document.getElementById('hourly_exemption_check');
        const hourlyInputs = document.getElementById('hourly_inputs');
        
        if (hourlyCheck && hourlyInputs) {
            // Function to toggle
            const toggleInputs = () => {
                hourlyInputs.style.display = hourlyCheck.checked ? 'block' : 'none';
                
                // Toggle required attribute for better UX
                const hourFrom = document.getElementById('hour_from');
                const hourTo = document.getElementById('hour_to');
                if (hourFrom) hourFrom.required = hourlyCheck.checked;
                if (hourTo) hourTo.required = hourlyCheck.checked;
            };
            
            // Listen for changes
            hourlyCheck.addEventListener('change', toggleInputs);
            
            // Run once on load
            toggleInputs();
        }
    });
</script>
{% endblock %}
