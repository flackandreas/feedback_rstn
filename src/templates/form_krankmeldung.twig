{% extends "base.twig" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>{% if editing_request %}Krankmeldung bearbeiten{% else %}Krankmeldung{% endif %}</h2>
    <a href="/index.php" class="button-secondary" style="text-decoration:none;">&larr; Zurück</a>
</div>

<div class="content-box">
    <div class="status info" style="margin-bottom: 20px;">
        <strong>Hinweis:</strong> Ab dem 3. Krankheitstag bitten wir um das Hochladen oder Nachreichen einer Arbeitsunfähigkeitsbescheinigung (AU).
    </div>

    <form method="POST" action="/krankmeldung.php" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        {% if editing_request %}
            <input type="hidden" name="edit_id" value="{{ editing_request.id }}">
        {% endif %}

        <div class="form-grid-2">
            <div class="form-group">
                <label for="date_from">Voraussichtlich Krank von *</label>
                <input type="date" id="date_from" name="date_from" required value="{{ editing_request ? editing_request.date_from : 'now'|date('Y-m-d') }}">
            </div>

            <div class="form-group">
                <label for="date_to">Bis (geschätzt) *</label>
                <input type="date" id="date_to" name="date_to" required value="{{ editing_request ? editing_request.date_to : '+2 days'|date('Y-m-d') }}">
            </div>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label for="material_link">Link zum Vertretungsmaterial (z.B. Nextcloud, Mebis) - Optional</label>
            <input type="url" id="material_link" name="material_link" placeholder="https://cloud.schule.de/s/..." value="{{ editing_request ? editing_request.material_link : '' }}" style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px;">
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label for="notes">Zusätzliche Notizen (Optional)</label>
            <textarea id="notes" name="notes" rows="3" placeholder="z.B. Klassenbuch liegt im Fach.">{{ editing_request ? editing_request.notes : '' }}</textarea>
        </div>
        
        <div class="form-group" style="margin-top: 15px;">
            <label for="attachment">Arbeitsunfähigkeitsbescheinigung (AU) - PDF, JPG, PNG (Optional)</label>
            {% if editing_request and editing_request.attachment_path %}
                <p style="font-size: 0.9em; margin-bottom: 5px;">Eine Datei wurde bereits hochgeladen: <a href="{{ editing_request.attachment_path }}" target="_blank">Datei ansehen</a>. Laden Sie hier eine neue Datei hoch, um sie zu ersetzen.</p>
            {% endif %}
            <input type="file" id="attachment" name="attachment" accept=".pdf,image/jpeg,image/png" style="padding: 10px; border: 1px dashed var(--border-color); width: 100%;">
        </div>

        <div style="margin-top: 25px; text-align: right;">
            {% if editing_request %}
                <a href="/krankmeldung.php" class="button-secondary" style="margin-right: 10px;">Abbrechen</a>
                <button type="submit" class="button-primary">Aktualisieren</button>
            {% else %}
                <button type="submit" class="button-danger">Meldung abgeben</button>
            {% endif %}
        </div>
    </form>
</div>

<!-- History log preview -->
<div class="content-box">
    <h3>Ihre letzten Krankmeldungen</h3>
    {% if requests is empty %}
        <p style='color: var(--text-muted);'>Keine Meldungen in letzter Zeit.</p>
    {% else %}
        <table class='data-table simple'>
            <thead>
                <tr>
                    <th>Eingereicht am</th>
                    <th>Von</th>
                    <th>Bis</th>
                    <th>AU hochgeladen</th>
                    <th>Aktion</th>
                </tr>
            </thead>
            <tbody>
                {% for r in requests %}
                    <tr>
                        <td style="color: var(--text-muted);">{{ r.created_at|date('d.m.Y') }}</td>
                        <td>{{ r.date_from|date('d.m.Y') }}</td>
                        <td>{{ r.date_to|date('d.m.Y') }}</td>
                        <td>{% if r.attachment_path %}✅ Ja{% else %}❌ Nein{% endif %}</td>
                        <td><a href="/krankmeldung.php?id={{ r.id }}" class="button-secondary" style="padding: 3px 8px; font-size: 0.8em; text-decoration: none;">Bearbeiten</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}
