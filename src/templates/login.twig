{% extends "base.twig" %}

{% block extra_head %}
<style>
    /* Make the login page background use the wertvoll.png image */
    .login-layout {
        background-image: url('/img/wellen.svg') !important;
        background-size: 100% auto !important;
        background-position: center !important;
        background-repeat: repeat-y !important;
        background-color: var(--bg-main) !important;
    }
    
    /* Ensure the login card is beautifully visible on top of the background */
    .content-box {
        background: rgba(255, 255, 255, 0.85) !important;
        backdrop-filter: blur(8px);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2) !important;
        border: 1px solid rgba(255, 255, 255, 0.4) !important;
    }
</style>
{% endblock %}

{% block content_public %}
<div class="content-box" style="width: 100%; max-width: 400px; padding: 40px;">
    <div style="text-align: center; margin-bottom: 30px;">
        <div style="display: flex; align-items: center; justify-content: center; gap: var(--space-3); margin-bottom: var(--space-2);">
            <svg width="38" height="38" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <path d="M16 4L4 10L16 16L28 10L16 4Z" fill="var(--primary-color)"/>
                <path d="M4 14.5V21.5L16 27.5L28 21.5V14.5L16 20.5L4 14.5Z" fill="var(--primary-color)" opacity="0.55"/>
            </svg>
            <h1 style="margin: 0; color: var(--text-dark); font-size: var(--text-2xl); font-weight: 800; letter-spacing: -0.03em;">SchulOS</h1>
        </div>
        <p style="color: var(--text-dark); font-size: var(--text-base); font-weight: 600; margin: 0;">Antragssystem</p>
        <p style="color: var(--text-muted); font-size: 0.9em; margin-top: 8px;">Lehrer-Login</p>
    </div>

    <form method="POST" action="/login.php">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        
        <div class="form-group">
            <label for="kuerzel">Kürzel:</label>
            <input type="text" id="kuerzel" name="kuerzel" required autofocus>
        </div>

        <div class="form-group">
            <label for="passwort">Passwort:</label>
            <input type="password" id="passwort" name="passwort" required>
        </div>

        <div style="margin-top: 25px;">
            <button type="submit" class="button-primary" style="width: 100%;">Anmelden</button>
        </div>

        <div style="text-align: center; margin: 20px 0; color: #aaa;">oder</div>

        <div>
            <a href="/login_sso.php" class="button-secondary" style="display: block; text-align: center; text-decoration: none; padding: 12px; border-radius: 4px; border: 1px solid #ccc; color: #444; background: #f9f9f9;">
                Mit IServ / Mebis / Cloud Account anmelden
            </a>
        </div>
    </form>
</div>
{% endblock %}
