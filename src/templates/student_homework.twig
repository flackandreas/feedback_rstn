<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ assignment.title }} - Hausaufgabe Einreichen</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #2ecc71;
            --primary-dark: #27ae60;
            --bg-color: #f8fafc;
            --text-dark: #2c3e50;
            --border-color: #e2e8f0;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-dark);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }
        .container {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            padding: 40px;
            width: 100%;
            max-width: 600px;
            margin-top: 40px;
            align-self: flex-start;
        }
        h1 { margin-top: 0; color: var(--primary-dark); font-size: 1.5rem; }
        .meta { color: #64748b; font-size: 0.9rem; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--border-color); }
        .form-group { margin-bottom: 20px; }
        label { display: block; font-weight: 500; margin-bottom: 8px; }
        input[type="text"], input[type="file"] {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            box-sizing: border-box;
            font-family: inherit;
        }
        input[type="file"] {
            padding: 10px;
            background: #f8fafc;
            cursor: pointer;
        }
        button {
            width: 100%;
            padding: 14px;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        button:hover {
            background-color: var(--primary-dark);
        }
        .alert {
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
        }
        .alert-error { background-color: #fee2e2; color: #991b1b; border: 1px solid #f87171; }
        .alert-success { background-color: #dcfce7; color: #166534; border: 1px solid #86efac; }
        
        .loading { display: none; text-align: center; margin-top: 20px; }
        .spinner {
            border: 4px solid rgba(0, 0, 0, 0.1);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border-left-color: var(--primary-color);
            animation: spin 1s linear infinite;
            margin: 0 auto 15px auto;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>

<div class="container">
    <h1>{{ assignment.title }}</h1>
    <div class="meta">{{ assignment.klasse }} - {{ assignment.fach }}</div>

    {% if error %}
        <div class="alert alert-error">{{ error }}</div>
    {% endif %}

    {% if result %}
        <div class="alert alert-success">
            <h3 style="margin-top: 0; color: #166534;">Hausaufgabe eingereicht!</h3>
            <p>Danke für deine Einreichung. Hier ist dein Feedback:</p>
        </div>
        
        <div style="background: #f0fdf4; padding: 20px; border-radius: 8px; border-left: 4px solid var(--primary-color); white-space: pre-wrap; line-height: 1.5;">{{ result.student_feedback }}</div>
        
        {% if result.score is not null %}
            <div style="text-align: right; margin-top: 15px; font-weight: bold; font-size: 1.1em; color: var(--primary-dark);">Bewertung: {{ result.score }} Punkte</div>
        {% endif %}
    {% else %}
        <p style="margin-bottom: 25px;">Bitte trage deinen Namen ein und lade ein Foto deiner Hausaufgabe hoch. Die Auswertung dauert ca. 10-20 Sekunden.</p>
        
        <form action="" method="POST" enctype="multipart/form-data" id="uploadForm" onsubmit="showLoading()">
            <div class="form-group">
                <label for="student_name">Dein Vor- und Nachname</label>
                <input type="text" id="student_name" name="student_name" required placeholder="z.B. Max Mustermann">
            </div>
            
            <div class="form-group" style="margin-bottom: 30px;">
                <label for="homework_image">Foto der Hausaufgabe (JPG, PNG)</label>
                <input type="file" id="homework_image" name="homework_image" accept="image/jpeg, image/png, image/webp" capture="environment" required>
            </div>
            
            <button type="submit" id="submitBtn">Hochladen & Auswerten lassen</button>
            
            <div class="loading" id="loadingSection">
                <div class="spinner"></div>
                <div style="color: #64748b; font-weight: 500;">Die KI analysiert deine Hausaufgabe...<br><small>Bitte schließe diese Seite nicht.</small></div>
            </div>
        </form>

        <script>
            function showLoading() {
                document.getElementById('submitBtn').style.display = 'none';
                document.getElementById('loadingSection').style.display = 'block';
            }
        </script>
    {% endif %}
</div>

</body>
</html>
