{
    "name": "schulos/sso",
    "description": "OpenID-Connect-Client fuer die SchulOS-Module. Eine Quelle statt einer Kopie je Modul.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SchulOS\\Sso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SchulOS\\Sso\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always tests"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    }
}
